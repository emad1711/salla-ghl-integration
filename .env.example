# Go High Level / LeadConnector
APP_ENV=production
SERVICE_NAME=salla-ghl-webhook
LOG_LEVEL=INFO
APP_BASE_URL=https://your-production-domain.com
# Railway injects PORT automatically. Keep this only for local Docker runs.
PORT=8010
# Railway Postgres may provide postgresql://...; the app normalizes it to asyncpg.
DATABASE_URL=postgresql+asyncpg://salla:change_this_database_password@postgres:5432/salla_ghl
REDIS_URL=redis://redis:6379/0
ENABLE_REDIS=true
# Local Docker Compose only. Railway Postgres sets its own credentials.
POSTGRES_DB=salla_ghl
POSTGRES_USER=salla
POSTGRES_PASSWORD=change_this_database_password

GHL_PRIVATE_INTEGRATION_TOKEN=put_your_private_integration_token_here
GHL_LOCATION_ID=put_your_location_id_here
GHL_BASE_URL=https://services.leadconnectorhq.com
GHL_API_VERSION=2021-07-28
GHL_SOURCE=Salla
GHL_TIMEOUT_SECONDS=20
GHL_PIPELINE_ID=
GHL_PIPELINE_STAGE_ID=
GHL_OPPORTUNITY_STATUS=open

# Salla webhook security
# Use the same secret configured in the Salla webhook/app settings.
SALLA_CLIENT_ID=
SALLA_CLIENT_SECRET=
SALLA_WEBHOOK_SECRET=put_salla_webhook_secret_here
SALLA_API_BASE_URL=https://api.salla.dev/admin/v2
# Legacy fallback only. Production installs should persist tokens from app.store.authorize.
SALLA_API_TOKEN=

# Optional token strategy support if you configure Salla to send Authorization.
SALLA_WEBHOOK_TOKEN=

# Supported store events processed by the business workflow pipeline.
# app.store.authorize is handled separately by /webhooks/salla/authorize.
SALLA_ALLOWED_EVENTS=order.created,order.updated,order.status.updated,order.completed,order.delivered,order.cancelled,order.refunded,order.canceled,order.status_changed,order.updated_status,customer.created,customer.registered,customer.updated,customer.created_or_registered,abandoned.cart,abandoned.cart.status.changed,abandoned.cart.purchased,cart.abandoned,abandoned_cart.created,abandoned.cart.created,product.stock.updated,product.quantity.updated,product.updated

# Workflow thresholds and delays
VIP_TOTAL_SPENT_THRESHOLD=1000
LOYALTY_POINTS_PER_CURRENCY_UNIT=1
LOYALTY_POINTS_PER_ORDER=0
LOYALTY_ELIGIBLE_STATUSES=created,paid,completed,delivered
INACTIVE_DAYS_THRESHOLD=60
REVIEW_REQUEST_DELAY_HOURS=48
ABANDONED_CART_DELAYS_MINUTES=30,1440,2880
MAX_RETRY_ATTEMPTS=5
RETRY_BASE_DELAY_SECONDS=30

# Optional admin/security/monitoring
ADMIN_API_KEY=
ENABLE_SENTRY=false
SENTRY_DSN=

# Optional GHL custom field IDs. Leave empty until you create fields in GHL.
GHL_CF_SALLA_ORDER_ID=
GHL_CF_SALLA_ORDER_TOTAL=
GHL_CF_SALLA_ORDER_STATUS=
GHL_CF_SALLA_ORDER_ADMIN_URL=
GHL_CF_SALLA_PAYMENT_METHOD=
GHL_CF_SALLA_PRODUCTS=
GHL_CF_SALLA_LAST_EVENT=
GHL_CF_SALLA_LAST_ORDER_AT=
GHL_CF_SALLA_TOTAL_SPENT=
GHL_CF_SALLA_PURCHASE_COUNT=
GHL_CF_SALLA_LAST_PURCHASE_AT=
GHL_CF_SALLA_LOYALTY_POINTS=
